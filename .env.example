# Copy to .env and fill in. Never commit .env.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any model on the free tier works. gemini-3.8-flash is the current default.
GEMINI_MODEL=gemini-3.8-flash

# Django
DJANGO_SECRET_KEY=change-me-to-something-random
# DEBUG defaults to OFF when the key is absent. Set DJANGO_DEBUG=1 for local
# development; in production leave it unset or set to 0.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production add your host and, for HTTPS, the matching origin:
#   DJANGO_ALLOWED_HOSTS=quizcraft.onrender.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://quizcraft.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production database for Django's own tables (auth, sessions, admin) for
# deployments that keep DATA_STORE off. When DATA_STORE=firestore the accounts
# and sessions live in Firestore instead and this stays unset. SQLite is used
# when unset -- keep it unset for local dev and the test suite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Drop the uploaded source bytes right after text extraction (1) or keep them
# on the server disk (0). Host filesystems are ephemeral, so 1 is recommended
# in production unless you point MEDIA_ROOT at a persistent disk/bucket.
DISCARD_SOURCE_UPLOADS=0

# Generation tuning
MAX_UPLOAD_MB=15
CHUNK_CHARS=12000
CHUNK_OVERLAP_CHARS=400
GEMINI_MAX_RETRIES=5
GEMINI_BACKOFF_BASE=3

# --- Firebase (optional) ------------------------------------------------
# Cloud Firestore can back everything instead of SQLite: business data, the
# accounts and the sessions. To enable:
#   1. Download your service-account JSON from Firebase console -> Settings
#      -> Service accounts -> Generate new private key.
#   2. Set FIREBASE_CREDENTIAL_PATH to that file and FIREBASE_PROJECT_ID to
#      your project id, then set DATA_STORE=firestore.
# Leave all three empty to keep using SQLite.
DATA_STORE=
FIREBASE_CREDENTIAL_PATH=
FIREBASE_PROJECT_ID=
